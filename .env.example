# Copy to .env and fill in the keys for the providers you want to use.
# You only need keys for the providers you actually use.
#
# Run `ai-code-agent providers` for the full catalog with default models.

# ── Native APIs ────────────────────────────────────────────────────────────
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Ollama — no API key, just point at a running server.
OLLAMA_BASE_URL=http://localhost:11434

# ── Cloud-native auth (no API key here; uses SDK credential chains) ────────
# Azure OpenAI — set both:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Anthropic on Vertex AI — gcloud ADC. Set:
GOOGLE_CLOUD_PROJECT=
# CLOUD_ML_REGION=us-east5

# Anthropic on Bedrock — standard AWS credential chain. Set:
# AWS_REGION=us-east-1

# ── OpenAI-compatible third-party hosts ────────────────────────────────────
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
MOONSHOT_API_KEY=
MOONSHOT_CN_API_KEY=
DEEPINFRA_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
NEBIUS_API_KEY=
NOVITA_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_CN_API_KEY=
ZHIPU_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
MODELSCOPE_API_KEY=
STEPFUN_API_KEY=
MINIMAX_API_KEY=
MINIMAXI_API_KEY=
OVH_AI_TOKEN=
SCALEWAY_API_KEY=
UPSTAGE_API_KEY=
POE_API_KEY=
VENICE_API_KEY=
AI_GATEWAY_API_KEY=
GITHUB_TOKEN=
COHERE_API_KEY=
FRIENDLI_TOKEN=
AI302_API_KEY=
AIHUBMIX_API_KEY=

# ── Custom / bring-your-own OpenAI-compatible endpoint ─────────────────────
# Use with `--provider custom`.
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# ── Defaults (optional) ────────────────────────────────────────────────────
# Run `ai-code-agent providers` to see all valid provider ids.
AI_CODE_AGENT_PROVIDER=
AI_CODE_AGENT_MODEL=
